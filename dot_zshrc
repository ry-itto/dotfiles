# Inherited FPATH can point to a removed zsh version (e.g. after brew upgrade zsh);
# keep the current zsh's functions dir and drop entries that no longer exist.
fpath=(/opt/homebrew/opt/zsh/share/zsh/functions /usr/share/zsh/$ZSH_VERSION/functions $fpath)
fpath=(${^fpath}(N-/))
typeset -U fpath

source $HOME/.zsh/alias.zsh
source $HOME/.zsh/env.zsh
source $HOME/.zsh/style.zsh
source $HOME/.zsh/plugin.zsh


#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"
